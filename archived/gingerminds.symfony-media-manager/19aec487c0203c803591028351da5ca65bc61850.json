{
    "manifests": {
        "gingerminds/symfony-media-manager": {
            "manifest": {
                "bundles": {
                    "Gingerminds\\MediaManagerBundle\\GingermindsMediaManagerBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * <fg=blue>Storage</>: the files go to <comment>var/storage/media</> by default; the",
                    "    <comment>default.storage</> of <comment>config/packages/flysystem.yaml</> is not used unless mapped",
                    "    in <comment>config/packages/gingerminds_media_manager.yaml</>",
                    "",
                    "  * <fg=blue>Production</>: keep <comment>var/storage/media</> on a persistent volume,",
                    "    or the files are lost on every redeploy of the container",
                    "",
                    "  * <fg=blue>Database</>: generate and run the migration, then create the permissions:",
                    "      <comment>php bin/console doctrine:migrations:diff</>",
                    "      <comment>php bin/console doctrine:migrations:migrate</>",
                    "      <comment>php bin/console gingerminds:permissions:sync</>",
                    "",
                    "  * <fg=blue>Several servers</>: use a shared lock store (e.g. <comment>LOCK_DSN=redis://redis:6379</>)",
                    "",
                    "  * <fg=blue>Baskets</>: purge the expired guest baskets every day:",
                    "      <comment>php bin/console gingerminds:media:basket:purge</>"
                ]
            },
            "files": {
                "config/packages/gingerminds_media_manager.yaml": {
                    "contents": [
                        "# Full reference: bin/console config:dump-reference gingerminds_media_manager",
                        "# Documentation: vendor/gingerminds/symfony-media-manager/docs",
                        "gingerminds_media_manager:",
                        "    # Storage: without configuration, the files go to a private local storage declared by the",
                        "    # bundle (var/storage/media). The `default.storage` of config/packages/flysystem.yaml is NOT",
                        "    # used unless you map it below. Keep the storage out of public/: the files are served by",
                        "    # GET /api/files/{id}, with the headers that keep an uploaded SVG from running scripts.",
                        "    #",
                        "    # To store them elsewhere, declare a Flysystem storage, then map it to a disk name:",
                        "    #",
                        "    #   # config/packages/flysystem.yaml",
                        "    #   flysystem:",
                        "    #       storages:",
                        "    #           media.storage:",
                        "    #               adapter: 'local'",
                        "    #               options:",
                        "    #                   directory: '%kernel.project_dir%/var/storage/media'",
                        "    #",
                        "    #           # S3 (composer require league/flysystem-aws-s3-v3), with an Aws\\S3\\S3Client service:",
                        "    #           # media.storage:",
                        "    #           #     adapter: 'aws'",
                        "    #           #     options:",
                        "    #           #         client: 'Aws\\S3\\S3Client'",
                        "    #           #         bucket: '%env(MEDIA_S3_BUCKET)%'",
                        "    #",
                        "    # storage:",
                        "    #     default_disk: default        # disk of the new uploads",
                        "    #     disks:                       # disk name => Flysystem storage service id",
                        "    #         default: media.storage",
                        "",
                        "    # library:",
                        "    #     max_upload_size: 51200     # KB, below the PHP and web server limits",
                        "",
                        "    # basket:",
                        "    #     enabled: true",
                        "    #     ttl: 30                    # days of a guest basket, 0: forever",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/gingerminds_media_manager.yaml": {
                    "contents": [
                        "# Write endpoints of the file library. The resource routes come from the core",
                        "# `gingerminds_crud` loader, the API ones from API Platform.",
                        "gingerminds_media_manager:",
                        "    resource: '@GingermindsMediaManagerBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "19aec487c0203c803591028351da5ca65bc61850"
        }
    }
}
